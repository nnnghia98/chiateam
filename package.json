{
  "name": "chiateam-bot",
  "version": "1.3.0",
  "description": "Telegram, Zalo and Messenger bot plus HTTP API for organising weekly football sessions.",
  "private": true,
  "main": "bot/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nnnghia98/chiateam.git"
  },
  "bugs": {
    "url": "https://github.com/nnnghia98/chiateam/issues"
  },
  "homepage": "https://github.com/nnnghia98/chiateam#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "yarn start:bot",
    "start:bot": "node bot/index.js",
    "start:api": "node api/index.js",
    "start:production": "yarn start:bot",
    "dev": "yarn dev:bot",
    "dev:bot": "nodemon bot/index.js",
    "dev:zalo": "nodemon bot/zalo-index.js",
    "dev:api": "nodemon api/index.js",
    "setup": "node scripts/setup.js",
    "dev:all": "node scripts/dev-all.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "zalo:webhook:set": "node scripts/zalo-webhook.js set",
    "zalo:webhook:info": "node scripts/zalo-webhook.js info",
    "zalo:webhook:test": "node scripts/zalo-webhook.js test",
    "zalo:webhook:delete": "node scripts/zalo-webhook.js delete",
    "init-db": "node api/db/init-database.js",
    "import:worldcup": "node api/db/import-worldcup-matches.js",
    "drop-db": "node api/db/drop-database.js",
    "start:admin": "node api/management-index.js",
    "start:zalo": "node bot/zalo-index.js",
    "start:zalo-webhook": "node api/zalo-webhook-server.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.4.5",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.65.1",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.0.0"
  },
  "resolutions": {
    "qs": "^6.16.0",
    "uuid": "^11.1.1",
    "ajv": "^6.14.0"
  }
}
