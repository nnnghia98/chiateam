{
  "name": "chiateam-bot",
  "version": "1.2.0",
  "private": true,
  "main": "bot/index.js",
  "license": "MIT",
  "scripts": {
    "start": "yarn start:bot",
    "start:bot": "NODE_ENV=production node bot/index.js",
    "start:api": "NODE_ENV=production node api/index.js",
    "start:production": "yarn start:bot",
    "dev": "yarn dev:bot",
    "dev:bot": "NODE_ENV=development nodemon bot/index.js",
    "dev:zalo": "NODE_ENV=development nodemon bot/zalo-index.js",
    "dev:api": "NODE_ENV=development nodemon api/index.js",
    "setup": "node scripts/setup.js",
    "dev:all": "node scripts/dev-all.js",
    "test": "node --test",
    "zalo:webhook:set": "node scripts/zalo-webhook.js set",
    "zalo:webhook:info": "node scripts/zalo-webhook.js info",
    "zalo:webhook:test": "node scripts/zalo-webhook.js test",
    "zalo:webhook:delete": "NODE_ENV=production node scripts/zalo-webhook.js delete",
    "docker:dev:up": "docker compose --env-file .env -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose --env-file .env -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose --env-file .env -f docker-compose.dev.yml logs -f --tail=200",
    "docker:prod:up": "docker compose --env-file .env -f docker-compose.yml up -d",
    "docker:prod:down": "docker compose --env-file .env -f docker-compose.yml down",
    "init-db": "node api/db/init-database.js",
    "import:worldcup": "node api/db/import-worldcup-matches.js",
    "drop-db": "node api/db/drop-database.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.4.5",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.65.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.0.0"
  }
}
