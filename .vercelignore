# Keep only the webhook entries from the API directory. Shared source stays
# available so Vercel file tracing can follow new local dependencies.
!/api
/api/*
!/api/zalo-webhook.mjs
!/api/messenger-webhook.mjs
!/api/management
/api/management/*
!/api/management/catalog.js

# Never upload local or generated data.
.env*
.git/
.vercel/
node_modules/
api/data/bot/*
coverage/
.nyc_output/
.cache/
logs/
*.log
*.pid
*.pid.lock

# Documentation is not needed by the webhook functions.
docs/
2026/
