# Legacy template. Prefer using:
# - .env.example -> .env
# - .env.production.example -> .env.production
#
# Environment File Identifier (for logging which env file is loaded)
ENV_FILE=.env

# Telegram Bot Configuration
BOT_OWNER_ID=your_bot_owner_id_here
BOT_ADMIN_IDS=your_bot_admin_1_id_here,your_bot_admin_2_id_here
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Zalo Bot Configuration
ZALO_BOT_TOKEN=your_zalo_bot_token_here
ZALO_BOT_OWNER_ID=your_zalo_owner_user_id_here
ZALO_BOT_ADMIN_IDS=your_zalo_admin_1_id_here,your_zalo_admin_2_id_here

# Required when the production Vercel webhook is registered.
ZALO_WEBHOOK_URL=https://your-vercel-project.vercel.app/webhook/zalo
ZALO_WEBHOOK_SECRET=replace-with-8-to-256-random-characters

# Chat & Thread Configuration
CHAT_ID=your_chat_id_here
DEFAULT_THREAD_ID=
MAIN_THREAD_ID=your_thread_id_here
ANNOUNCEMENT_THREAD_ID=your_thread_id_here
VIP_THREAD_ID=your_thread_id_here
STATISTICS_THREAD_ID=your_thread_id_here

# API / runtime configuration
API_PORT=8787
BOT_STATE_FILE=/api/data/bot/storage.json
INTERNAL_API_AUTH_TOKEN=change-this-shared-internal-token
# Vercel must use the API's public HTTPS URL. Local shells can use localhost.
BOT_API_BASE_URL=http://127.0.0.1:8787
MAINTENANCE_MODE=false
MAINTENANCE_UNTIL=

# Database
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Supabase Storage for player avatar uploads
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=player-avatars

# Optional UI origins for CORS
ADMIN_UI_URL=http://localhost:8389
