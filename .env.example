# Safe placeholders only. Copy to the root .env and set values for this environment.
# Do not put real credentials in this example.

# BOT

# Telegram credentials and access.
TELEGRAM_BOT_TOKEN=your_bot_token_here
BOT_OWNER_ID=your_bot_owner_id_here
BOT_ADMIN_IDS=your_bot_admin_1_id_here,your_bot_admin_2_id_here

# Optional Telegram-only ChiaTeam text actions. No key means disabled.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TELEGRAM_JEV_ENABLED=true
# Optional readable Jev action logs. Tagged requests follow Jev before execution.
# Works locally and in production when enabled. Logs contain message text.
TELEGRAM_JEV_SANDBOX=false

# Optional Telegram group routing; private command replies stay in the incoming chat.
# Leave CHAT_ID and all five topic IDs empty for use without a group.
# Topic IDs belong to CHAT_ID and are ignored when CHAT_ID is empty.
CHAT_ID=your_chat_id_here
DEFAULT_THREAD_ID=
MAIN_THREAD_ID=your_thread_id_here
ANNOUNCEMENT_THREAD_ID=your_thread_id_here
VIP_THREAD_ID=your_thread_id_here
STATISTICS_THREAD_ID=your_thread_id_here

# Zalo credentials and access.
ZALO_BOT_TOKEN=your_zalo_bot_token_here
ZALO_BOT_OWNER_ID=your_zalo_owner_user_id_here
ZALO_BOT_ADMIN_IDS=your_zalo_admin_1_id_here,your_zalo_admin_2_id_here

# Zalo webhook registration and receiver. Keep the URL and secret when using a webhook.
ZALO_WEBHOOK_URL=https://your-vercel-project.vercel.app/webhook/zalo
ZALO_WEBHOOK_SECRET=replace-with-8-to-256-random-characters
ZALO_WEBHOOK_PORT=8791

# Optional Messenger webhook credentials. Set the callback URL directly in Meta settings.
MESSENGER_PAGE_ID=your_facebook_page_id_here
MESSENGER_PAGE_ACCESS_TOKEN=your_page_access_token_here
MESSENGER_APP_SECRET=your_meta_app_secret_here
MESSENGER_VERIFY_TOKEN=replace-with-a-random-verification-token
MESSENGER_GRAPH_API_VERSION=v26.0
MESSENGER_ADMIN_IDS=

# API

# Shared runtime mode for BOT and API. This does not select another env file.
NODE_ENV=development

# API listener and bot-to-API connection. Webhooks need a reachable HTTPS API URL.
API_PORT=8787
BOT_API_BASE_URL=http://127.0.0.1:8787

# Shared internal authentication for API and bot clients.
INTERNAL_API_AUTH_TOKEN=change-this-shared-internal-token

# Shared maintenance settings for the API and Telegram bot.
MAINTENANCE_MODE=false
MAINTENANCE_UNTIL=

# Required: PostgreSQL is the only persistent bot-state store.
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Optional Supabase storage for player avatars and Zalo announcement images.
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=player-avatars
SUPABASE_ZALO_STORAGE_BUCKET=zalo-announcements

# Allowed web app origins. These are separate values; leave unused origins empty.
ADMIN_UI_URL=http://localhost:8389
WEB_UI_URL=

# Optional match commentary.
GEMINI_API_KEY=your_gemini_api_key_here

# Admin panel backend and managed startup for API and bot services.
# Enable MANAGEMENT_BOOTSTRAP only after the admin panel backend is ready.
MANAGEMENT_BOOTSTRAP=false
MANAGEMENT_API_URL=http://127.0.0.1:8790
MANAGEMENT_PORT=8790

# Admin panel settings database and encryption key. Keep existing values for saved settings.
MANAGEMENT_DATABASE_URL=postgresql://postgres:[password]@management-db.example:5432/management
MANAGEMENT_ENCRYPTION_KEY=base64-32-byte-key-held-outside-the-database

# Admin panel and service authentication. Every token must be different.
# The backend checks all tokens; each bot service also uses its matching token.
MANAGEMENT_ADMIN_TOKEN=change-this-admin-transport-token
MANAGEMENT_API_TOKEN=change-this-api-service-token
MANAGEMENT_TELEGRAM_TOKEN=change-this-telegram-service-token
MANAGEMENT_ZALO_POLLING_TOKEN=change-this-zalo-polling-service-token
MANAGEMENT_ZALO_WEBHOOK_TOKEN=change-this-zalo-webhook-service-token
MANAGEMENT_ADMIN_SERVICE_TOKEN=change-this-admin-service-token

# Destinations allowed for admin panel connection checks.
MANAGEMENT_ALLOWED_ORIGINS=http://127.0.0.1:8787
MANAGEMENT_ALLOWED_DATABASE_HOSTS=127.0.0.1,localhost
